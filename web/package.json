{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --import tsx --test test/format.test.ts test/decode.test.ts test/quoter.test.ts test/engine.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:int": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 test/live.test.ts",
    "record": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx scripts/record.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "4.19.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
