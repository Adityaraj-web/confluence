pragma solidity 0.8.30;

import {Test} from "forge-std/Test.sol";
import {Vm} from "forge-std/Vm.sol";
import {Vectors} from "../base/Vectors.sol";

/// @notice V2-00: every vector file in `test/vectors` parses, has the expected fields and is self-consistent.
/// @dev Reads files with `vm.readFile` and `vm.parseJson*` (no FFI). The files are generated by
///      `reference/gen_vectors.py`; this test only checks they can be loaded and add up, not the maths.
contract V200ReferenceTest is Test {
    // D-21, the v1 numbers the first v1_demo case must carry.
    uint256 internal constant V1_POOL_ONLY_WEI = 984934194542570551127;
    uint256 internal constant V1_HINTED_BEST_WEI = 991549823315669231761;

    function test_V200_vectorsLoad() public view {
        // The directory holds exactly the five files the generator writes.
        Vm.DirEntry[] memory entries = vm.readDir("test/vectors");
        assertEq(entries.length, 5, "unexpected number of vector files");

        _checkSplit(Vectors.SPLIT_2V, 2);
        _checkSplit(Vectors.SPLIT_3V, 3);
        _checkSplit(Vectors.SPLIT_CAPS, 0);
        _checkCrossing();
        _checkV1Demo();
    }

    /// @dev `venueCount` 0 means 2 or 3 (the caps file mixes both).
    function _checkSplit(string memory file, uint256 venueCount) internal view {
        string memory json = Vectors.read(file);
        uint256 n = Vectors.count(json);
        bool sawBindingCap;
        for (uint256 i; i < n; i++) {
            Vectors.Split memory s = Vectors.split(json, i);
            string memory ctx = string.concat(file, " ", s.name);
            if (venueCount != 0) assertEq(s.venues.length, venueCount, string.concat(ctx, ": venue count"));
            else assertTrue(s.venues.length == 2 || s.venues.length == 3, string.concat(ctx, ": venue count"));
            assertEq(s.alloc.length, s.venues.length, string.concat(ctx, ": alloc length"));
            assertEq(s.perVenue.length, s.venues.length, string.concat(ctx, ": perVenue length"));
            assertGt(s.amount, 0, string.concat(ctx, ": amount"));

            uint256 sumAlloc;
            uint256 sumPer;
            for (uint256 j; j < s.venues.length; j++) {
                assertGt(s.venues[j].x, 0, string.concat(ctx, ": x"));
                assertGt(s.venues[j].y, 0, string.concat(ctx, ": y"));
                assertLt(s.venues[j].feeE9, 1e9, string.concat(ctx, ": fee"));
                assertLe(s.alloc[j], s.venues[j].cap, string.concat(ctx, ": allocation over cap"));
                if (s.venues[j].cap != type(uint256).max && s.alloc[j] == s.venues[j].cap) sawBindingCap = true;
                sumAlloc += s.alloc[j];
                sumPer += s.perVenue[j];
            }
            assertEq(s.venues[0].cap, type(uint256).max, string.concat(ctx, ": the pool is never capped"));
            assertEq(sumAlloc, s.amount, string.concat(ctx, ": allocations do not sum to the amount"));
            assertEq(sumPer, s.totalInt, string.concat(ctx, ": per-venue amounts do not sum to the total"));
        }
        if (venueCount == 0) assertTrue(sawBindingCap, "the caps file has no binding cap");
    }

    function _checkCrossing() internal view {
        string memory json = Vectors.read(Vectors.POOL_CROSSING);
        uint256 n = Vectors.count(json);
        bool sawIn;
        bool sawOut;
        for (uint256 i; i < n; i++) {
            Vectors.Crossing memory c = Vectors.crossing(json, i);
            string memory ctx = string.concat("pool_crossing ", c.name);
            if (c.exactIn) sawIn = true;
            else sawOut = true;
            assertEq(c.allocPool + c.allocMaker, c.amount, string.concat(ctx, ": split != amount"));
            assertEq(c.poolLeg + c.makerLeg, c.totalInt, string.concat(ctx, ": legs != total"));
            assertGe(c.segments.length, 3, string.concat(ctx, ": the pool should have several ranges"));
            assertGe(c.rangesCrossed, 1, string.concat(ctx, ": no range crossed"));
            assertGe(c.ticksCrossed, 1, string.concat(ctx, ": no tick crossed"));
            assertEq(c.pool.ticks.length, c.pool.liquidityNets.length, string.concat(ctx, ": tick arrays"));
            assertEq(c.pool.ticks.length, 6, string.concat(ctx, ": initialised ticks"));
            int256 netSum;
            for (uint256 k; k < c.pool.liquidityNets.length; k++) {
                netSum += c.pool.liquidityNets[k];
            }
            assertEq(netSum, 0, string.concat(ctx, ": liquidityNet should net to zero over the whole range"));
            for (uint256 k; k < c.segments.length; k++) {
                assertGt(c.segments[k].liquidity, 0, string.concat(ctx, ": segment liquidity"));
            }
        }
        assertTrue(sawIn && sawOut, "pool_crossing needs exact-in and exact-out cases");
    }

    function _checkV1Demo() internal view {
        string memory json = Vectors.read(Vectors.V1_DEMO);
        uint256 n = Vectors.count(json);
        assertEq(n, 3, "v1_demo cases");
        for (uint256 i; i < n; i++) {
            Vectors.V1Case memory c = Vectors.v1Case(json, i);
            string memory ctx = string.concat("v1_demo ", c.name);
            assertEq(c.allocPool + c.allocPriya, c.amount, string.concat(ctx, ": split != amount"));
            assertEq(c.poolLeg + c.priyaLeg, c.totalInt, string.concat(ctx, ": legs != total"));
            assertGe(c.totalInt, c.poolOnlyOut, string.concat(ctx, ": closed form worse than pool-only"));
            assertGt(c.pool.liquidity, 0, string.concat(ctx, ": pool liquidity"));
            assertEq(c.pool.ticks.length, 2, string.concat(ctx, ": the v1 pool has one position"));
            assertEq(c.pool.feePips, 3000, string.concat(ctx, ": pool fee"));
            assertEq(c.hasHint, i == 0, string.concat(ctx, ": only the first case carries v1's hint"));
        }
        Vectors.V1Case memory first = Vectors.v1Case(json, 0);
        assertEq(first.poolOnlyOut, V1_POOL_ONLY_WEI, "D-21 pool-only");
        assertEq(first.hint, 550_000_000, "D-21 hint");
        assertEq(first.hintTotal, V1_HINTED_BEST_WEI, "D-21 hinted best");
        assertEq(first.hintAquaLeg + first.hintPoolLeg, first.hintTotal, "hinted legs");
        assertGt(first.totalInt, first.hintTotal, "the closed form must beat v1's hinted best");
    }
}
