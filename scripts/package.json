{
  "name": "confluence-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/quoter.test.ts test/f09.test.ts",
    "test:int": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 test/quoter.live.test.ts test/f09.live.test.ts",
    "abis": "tsx src/abis/generate.ts",
    "quote": "tsx src/quoter.ts",
    "fork": "bash -c 'set -a; source ../.env; set +a; exec anvil --fork-url \"$MAINNET_RPC_URL\" --fork-block-number \"$FORK_BLOCK\"'",
    "ship": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx src/shipStrategy.ts",
    "deploy": "bash -c 'set -a; source ../.env.example; [ -f ../.env ] && source ../.env; set +a; cd ../contracts && forge script script/Setup.s.sol --rpc-url http://127.0.0.1:8545 --broadcast' && pnpm run ship && pnpm run snapshot",
    "snapshot": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx src/demo.ts snapshot",
    "demo": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx src/demo.ts run",
    "demo:reset": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx src/demo.ts reset",
    "demo:guard": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx src/demo.ts guard"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "0.3.0",
    "@1inch/swap-vm-sdk": "0.4.0",
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsx": "4.19.0",
    "typescript": "5.6.3"
  }
}
